<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash logo: the gradient rounded-square + white "route" glyph, the
     same mark the Dart SplashScreen shows, so the launch is seamless. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Rounded-square tile (r=22) with the brand gradient. -->
    <path android:pathData="M32,10 L76,10 A22,22 0 0 1 98,32 L98,76 A22,22 0 0 1 76,98 L32,98 A22,22 0 0 1 10,76 L10,32 A22,22 0 0 1 32,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10" android:startY="10"
                android:endX="98" android:endY="98">
                <item android:offset="0" android:color="#FF7C6FFF" />
                <item android:offset="1" android:color="#FF00D4BC" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- White route glyph, centred on the tile. -->
    <group
        android:scaleX="2.0"
        android:scaleY="2.0"
        android:translateX="30"
        android:translateY="30">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M19 15.18V7c0-2.21-1.79-4-4-4s-4 1.79-4 4v10c0 1.1-.9 2-2 2s-2-.9-2-2V8.82C8.16 8.4 9 7.3 9 6c0-1.66-1.34-3-3-3S3 4.34 3 6c0 1.3.84 2.4 2 2.82V17c0 2.21 1.79 4 4 4s4-1.79 4-4V7c0-1.1.9-2 2-2s2 .9 2 2v8.18C16.84 15.6 16 16.7 16 18c0 1.66 1.34 3 3 3s3-1.34 3-3c0-1.3-.84-2.4-2-2.82zM6 7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm13 13c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
    </group>
</vector>
